# bookent.ai self-hosted messaging engine
# Never commit real secrets.

FRONTEND_URL=https://messages.bookent.ai
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=api_only

SECRET_KEY_BASE=replace_with_secure_random_value

POSTGRES_HOST=postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace_with_secure_random_value

REDIS_URL=redis://:replace_with_secure_random_value@redis:6379
REDIS_PASSWORD=replace_with_secure_random_value

RAILS_ENV=production
RAILS_MAX_THREADS=5
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

ACTIVE_STORAGE_SERVICE=local

MAILER_SENDER_EMAIL=bookent.ai <notifications@bookent.ai>
SMTP_DOMAIN=bookent.ai
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

# Meta / Instagram will be added when the bookent.ai Meta app exists.
FB_VERIFY_TOKEN=
FB_APP_SECRET=
FB_APP_ID=
IG_VERIFY_TOKEN=

# Keep Chatwoot's own AI disabled. bookent.ai owns the AI layer.
# Captain/OpenAI credentials should not be configured here.
